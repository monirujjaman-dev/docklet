# systemd unit for running the docklet binary directly on a host that also
# runs Caddy (admin API on localhost:2019). The container install
# (install.sh) is the recommended way; use this for binary installs:
#
#   sudo install -m 0755 docklet-linux-amd64 /usr/local/bin/docklet
#   sudo cp deploy/docklet.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now docklet
#
# Upgrades: sudo docklet upgrade -restart
[Unit]
Description=Docklet control plane
Documentation=https://github.com/monirujjaman-dev/docklet
After=network-online.target docker.service caddy.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
# Root is required for the Docker socket (which is root-equivalent anyway).
ExecStart=/usr/local/bin/docklet serve
Environment=DOCKLET_DATA_DIR=/var/lib/docklet
Environment=DOCKLET_ADDR=:3000
Environment=DOCKLET_CADDY_ADMIN=http://localhost:2019
Restart=on-failure
RestartSec=2s
StateDirectory=docklet
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
